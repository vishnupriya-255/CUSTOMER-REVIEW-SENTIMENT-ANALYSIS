import numpy as np, pandas as pd, matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import PolynomialFeatures, StandardScaler
from sklearn.linear_model import LinearRegression, Ridge, Lasso, ElasticNet, RidgeCV
from sklearn.metrics import mean_squared_error, r2_score

# Load your dataset
df = pd.read_csv("student_placement_prediction_dataset_2026.csv")

# Use the correct column names from your CSV
base = ["attendance_percentage", "backlogs", "internships_count",
        "coding_skill_score", "communication_skill_score"]

# Polynomial expansion (degree 3)
X = PolynomialFeatures(3, include_bias=False).fit_transform(df[base])
y = df["cgpa"].values   # target variable

print("features after expansion:", X.shape[1])

# Train/test split
Xtr, Xte, ytr, yte = train_test_split(X, y, test_size=0.3, random_state=42)

# Scale features (fit only on train)
sc = StandardScaler().fit(Xtr)
Xtr, Xte = sc.transform(Xtr), sc.transform(Xte)

# Models to compare
for name, model in [
    ("OLS", LinearRegression()),
    ("Ridge L2", Ridge(alpha=10)),
    ("Lasso L1", Lasso(alpha=0.01, max_iter=20000)),
    ("ElasticNet", ElasticNet(alpha=0.01, l1_ratio=0.5, max_iter=20000))
]:
    model.fit(Xtr, ytr)
    tr = np.sqrt(mean_squared_error(ytr, model.predict(Xtr)))
    te = np.sqrt(mean_squared_error(yte, model.predict(Xte)))
    nz = int(np.sum(np.abs(model.coef_) > 1e-6))
    print(f"{name:10} train={tr:.4f} test={te:.4f} gap={te-tr:+.4f} kept={nz}/{X.shape[1]}")

# Ridge path
alphas = np.logspace(-3, 3, 50)
coefs = [Ridge(alpha=a).fit(Xtr, ytr).coef_ for a in alphas]
plt.plot(alphas, coefs)
plt.xscale("log")
plt.xlabel("alpha")
plt.ylabel("coefficient")
plt.title("Ridge path: bigger penalty -> smaller weights")
plt.show()

# Cross-validation to pick best alpha
best = RidgeCV(alphas=alphas, cv=5).fit(Xtr, ytr)
print("best alpha:", round(best.alpha_, 4), "| test R2:", round(r2_score(yte, best.predict(Xte)), 4))
