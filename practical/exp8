import pandas as pd, numpy as np
import xgboost as xgb, lightgbm as lgb, shap, joblib
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score, average_precision_score, classification_report

# -----------------------------
# Load dataset
# -----------------------------
df = pd.read_csv("student_placement_prediction_dataset_2026.csv")

# -----------------------------
# Target conversion (string → numeric)
# -----------------------------
df["placement_status"] = df["placement_status"].map({"Not Placed": 0, "Placed": 1})

# -----------------------------
# Handle missing values
# -----------------------------
if "communication_skill_score" in df.columns:
    df["communication_skill_score"] = df["communication_skill_score"].fillna(
        df["communication_skill_score"].median()
    )

# -----------------------------
# Encode categorical features
# -----------------------------
categorical_cols = ["branch", "gender", "college_tier", "volunteer_experience"]

df = pd.get_dummies(df, columns=categorical_cols, drop_first=True)

# -----------------------------
# Drop non-predictive / leakage columns
# -----------------------------
df = df.drop(columns=["student_id", "salary_package_lpa"], errors="ignore")

# -----------------------------
# Features & target
# -----------------------------
X, y = df.drop(columns="placement_status"), df["placement_status"]

print("Feature shape:", X.shape, "Target shape:", y.shape)

# -----------------------------
# Train/validation/test split
# -----------------------------
Xtr, Xtmp, ytr, ytmp = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)
Xva, Xte, yva, yte = train_test_split(Xtmp, ytmp, test_size=0.5, random_state=42, stratify=ytmp)

# -----------------------------
# Handle class imbalance
# -----------------------------
scale_pos_weight = (ytr.value_counts()[0] / ytr.value_counts()[1])

# -----------------------------
# XGBoost model
# -----------------------------
xg = xgb.XGBClassifier(
    n_estimators=1000,
    learning_rate=0.05,
    max_depth=4,
    subsample=0.8,
    eval_metric="auc",
    early_stopping_rounds=50,
    random_state=42,
    scale_pos_weight=scale_pos_weight
)
xg.fit(Xtr, ytr, eval_set=[(Xva, yva)], verbose=False)

# -----------------------------
# LightGBM model
# -----------------------------
lg = lgb.LGBMClassifier(
    n_estimators=1000,
    learning_rate=0.05,
    num_leaves=15,
    random_state=42,
    class_weight="balanced",
    verbose=-1
)
lg.fit(Xtr, ytr, eval_set=[(Xva, yva)], callbacks=[lgb.early_stopping(50, verbose=False)])

# -----------------------------
# Evaluation
# -----------------------------
for name, m in [("XGBoost", xg), ("LightGBM", lg)]:
    p = m.predict_proba(Xte)[:, 1]
    print(f"{name:<9} AUC={roc_auc_score(yte,p):.4f}  PR-AUC={average_precision_score(yte,p):.4f}")

print("\nClassification Report (XGBoost):")
print(classification_report(yte, xg.predict(Xte)))

# -----------------------------
# SHAP interpretability
# -----------------------------
explainer = shap.TreeExplainer(xg)
sv = explainer(Xte)

shap.summary_plot(sv, Xte)
shap.plots.waterfall(sv[0])
shap.plots.bar(sv)

# -----------------------------
# Save model
# -----------------------------
joblib.dump(xg, "placement_model.joblib")
