import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import PolynomialFeatures, StandardScaler
from sklearn.linear_model import LinearRegression, Ridge, Lasso, ElasticNet, RidgeCV, LassoCV
from sklearn.metrics import mean_squared_error

# Load dataset
df = pd.read_csv("student_placement_prediction_dataset_2026.csv")

# Use correct column names
features = ["study_hours_per_day","attendance_percentage","backlogs","projects_count"]

# Polynomial expansion
X = PolynomialFeatures(4, include_bias=False).fit_transform(df[features])

# Train/test split
Xtr, Xte, ytr, yte = train_test_split(X, df["cgpa"].values, test_size=0.3, random_state=42)

# Scale features
sc = StandardScaler().fit(Xtr)
Xtr, Xte = sc.transform(Xtr), sc.transform(Xte)

print("Features after expansion:", X.shape[1])

# RMSE function
rmse = lambda m: np.sqrt(mean_squared_error(yte, m.predict(Xte)))

# Models
for name, m in [
    ("OLS", LinearRegression()),
    ("Ridge", Ridge(10)),
    ("Lasso", Lasso(0.01, max_iter=20000)),
    ("ElasticNet", ElasticNet(0.01, l1_ratio=0.5, max_iter=20000))
]:
    m.fit(Xtr, ytr)
    print(f"{name:<11} train={np.sqrt(mean_squared_error(ytr,m.predict(Xtr))):.4f}"
          f" test={rmse(m):.4f} non-zero={np.sum(abs(m.coef_)>1e-6)}")

# Ridge path
alphas = np.logspace(-3, 3, 50)
coefs = [Ridge(a).fit(Xtr,ytr).coef_ for a in alphas]
plt.plot(alphas, coefs)
plt.xscale("log")
plt.title("Ridge path")
plt.xlabel("alpha")
plt.ylabel("coefficient")
plt.show()

# RidgeCV
ridgecv = RidgeCV(alphas=alphas).fit(Xtr,ytr)
print("RidgeCV alpha:", round(ridgecv.alpha_, 4))

# LassoCV
lcv = LassoCV(cv=5, max_iter=20000).fit(Xtr, ytr)
print("LassoCV alpha:", round(lcv.alpha_, 5), "| features kept:", np.sum(abs(lcv.coef_)>1e-6))
