#	Experiment	10	:	Dimensionality	Reduction	and	Anomaly	Detection
import	numpy	as	np,	pandas	as	pd,	matplotlib.pyplot	as	plt,	seaborn	as	sns
from	sklearn.preprocessing	import	StandardScaler
from	sklearn.decomposition	import	PCA
from	sklearn.manifold	import	TSNE
from	sklearn.ensemble	import	IsolationForest
from	sklearn.neighbors	import	LocalOutlierFactor
from	sklearn.svm	import	OneClassSVM
df	=	pd.read_csv("students_clean.csv")
F	=	["cgpa","attendance","backlogs","internships","coding_score","comm_score","projects","hours_study"]
X,	y	=	StandardScaler().fit_transform(df[F]),	df.placed.values
pca	=	PCA().fit(X);	cum	=	np.cumsum(pca.explained_variance_ratio_)
plt.plot(range(1,len(cum)+1),	cum,	'o-');	plt.axhline(.9,	color='r',	ls='--')
plt.xlabel("components");	plt.ylabel("cumulative	variance");	plt.title("Scree");	plt.show()
print("Components	for	90%	variance:",	int(np.argmax(cum>=.9)+1))
sns.heatmap(pd.DataFrame(pca.components_[:3].T,	index=F,	columns=["PC1","PC2","PC3"]),
annot=True,	fmt=".2f",	cmap="coolwarm",	center=0);	plt.title("Loadings");	plt.show()
X2	=	PCA(2,	random_state=0).fit_transform(X)
fig,	ax	=	plt.subplots(1,	3,	figsize=(15,4))
for	a,	perp	in	zip(ax,	[5,	30,	50]):
e	=	TSNE(2,	perplexity=perp,	init="pca",	random_state=0).fit_transform(X)
a.scatter(e[:,0],	e[:,1],	c=y,	cmap="coolwarm",	s=12);	a.set_title(f"t-SNE	perp={perp}")
plt.show()
flags	=	{"IsolationForest":	IsolationForest(contamination=.05,	random_state=0).fit_predict(X),
"LOF"												
"OneClassSVM"				

:	LocalOutlierFactor(20,	contamination=.05).fit_predict(X),
:	OneClassSVM(nu=.05,	gamma="scale").fit(X).predict(X)}
fig,	ax	=	plt.subplots(1,	3,	figsize=(15,4))
for	a,	(n,	p)	in	zip(ax,	flags.items()):
a.scatter(X2[:,0],	X2[:,1],	c=(p==-1),	cmap="coolwarm",	s=14);	a.set_title(n)
print(f"{n:<16}:	{(p==-1).sum()}	anomalies")
plt.show()
consensus	=	(pd.DataFrame(flags)	==	-1).sum(axis=1)	>=	2
print("Flagged	by	>=2	methods:",	consensus.sum())
print(df.loc[consensus,	F].mean().round(2))
