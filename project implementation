# ============================================================
# 12. PREPARE STOPWORDS
# ============================================================

# Words that carry sentiment are KEPT (not removed)

important_words = {
    'no',
    'not',
    'never',
    'nor',
    'neither',
    'cannot',
    'without',
    'but',
    'however',
    'although',
    'could',
    'can'
}

stop_words = (
    set(ENGLISH_STOP_WORDS) -
    important_words
)

print(
    "\nNumber of stopwords used:",
    len(stop_words)
)


# ============================================================
# 13. TEXT CLEANING FUNCTION
# ============================================================

def clean_text(text):

    text = str(text).lower()

    # remove URLs
    text = re.sub(
        r'http\S+|www\S+|https\S+',
        ' ',
        text
    )

    # punctuation -> space
    text = re.sub(
        r'[^\w\s]',
        ' ',
        text
    )

    # remove numbers
    text = re.sub(
        r'\d+',
        ' ',
        text
    )

    # remove stopwords / 1-letter junk
    words = [
        w
        for w in text.split()
        if w not in stop_words
        and len(w) > 1
    ]

    return ' '.join(words).strip()


# ============================================================
# 14. CLEAN ALL REVIEWS
# ============================================================

df['Original_Review'] = df['Review']

